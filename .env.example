# Copy this file to .env and set values locally. Do not commit .env.
# Keep real keys, passwords, and tokens only in your local .env file.

# News provider: enable only after the team selects a provider.
NEWS_API_KEY=

# Official market-data provider: add only if the selected provider requires an API key.
# TWSE_API_KEY=
# TPEX_API_KEY=

# LLM provider: add only after the Agent team confirms the service and model.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# LLM_MODEL_NAME=

# Database: add only if the project later uses a shared database.
# DATABASE_URL=

# Local runtime settings. Keep these in a version-controlled config file unless
# individual environments genuinely need different values.
# APP_ENV=development
# LOG_LEVEL=INFO
# TIMEZONE=Asia/Taipei
# RAW_DATA_DIR=data/raw
# PROCESSED_DATA_DIR=data/processed
